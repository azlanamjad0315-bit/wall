    {
      "id": "29686eed-151f-5e8d-88b5-f4ae516bf514",
      "name": "Budget",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        40
      ],
      "parameters": {
        "jsCode": "// today's capacity; a manual re-run in the same day continues instead of repeating\nconst max = parseInt($env.MAX_LEADS_PER_DAY || '20', 10);\nreturn [{ json: { max, date: new Date().toISOString().slice(0, 10) } }];",
        "mode": "runOnceForAllItems"
      },
      "executeOnce": true
    },
    {
      "id": "31edf3eb-cb3a-5b4c-b680-b62d5345b0a7",
      "name": "Read CRM · raw",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        40
      ],
      "parameters": {
        "url": "={{ $env.BASEROW_URL + '/api/database/rows/table/' + $env.BASEROW_TABLE_ID + '/' }}",
        "options": {
          "timeout": 900000,
          "response": {
            "neverError": true,
            "responseFormat": "json"
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Token ' + $env.BASEROW_TOKEN }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "user_field_names",
              "value": "true"
            },
            {
              "name": "limit",
              "value": "100000"
            }
          ]
        }
      },
      "notesInFlow": true,
      "notes": "supplies known lead_key values so we never rebuild a sent demo",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "id": "87456618-b98f-514d-b5b0-186a2d1ac2c2",
      "name": "Read CRM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        40
      ],
      "parameters": {
        "jsCode": "// Baserow row -> flat lead object + a few derived helpers every workflow needs\nconst src = $input.first().json || {};\nconst rows = Array.isArray(src.results) ? src.results : [];\nconst today = new Date().toISOString().slice(0, 10);\nconst clean = rows.map(r => {\n  const f = {};\n  for (const [k, v] of Object.entries(r)) {\n    if (v === null || v === undefined) { f[k] = ''; continue; }\n    f[k] = (typeof v === 'object' && !Array.isArray(v)) ? (v.text ?? v.value ?? JSON.stringify(v)) : v;\n  }\n  f.row_id = r.id ?? '';\n  const d = s => (s ? Math.floor((Date.now() - new Date(String(s).slice(0, 10)).getTime()) / 864e5) : 9999);\n  f._days_since_out = d(f.sent_at);\n  f._days_since_in = d(f.last_inbound);\n  f._contacted_today = String(f.sent_at || '').startsWith(today);\n  return f;\n});\n// 'keys' is what scan must NOT return again. Retryable statuses are deliberately left out,\n// so yesterday's demo_failed / stalled leads get one more shot today.\nconst RETRYABLE = ['demo_failed', 'scanned', 'stalled', 'deploy_pending'];\nreturn [{ json: { rows: clean,\n                  keys: clean.filter(r => RETRYABLE.indexOf(String(r.status || '')) < 0)\n                        .map(r => r.lead_key).filter(Boolean).join(','),\n                  retryable: clean.filter(r => RETRYABLE.indexOf(String(r.status || '')) >= 0).length,\n                  count: clean.length, today, empty: clean.length === 0 } }];",
        "mode": "runOnceForAllItems"
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "13a3713e-cb25-5843-8b9f-dc9086161ea0",
      "name": "Radar: scan OSM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        40
      ],
      "parameters": {
        "url": "={{ $env.GATEWAY_URL + '/v1/leads/scan' }}",
        "options": {
          "timeout": 900000,
          "response": {
            "neverError": true,
            "responseFormat": "json"
          }
        },
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Gateway-Token",
              "value": "={{ $env.GATEWAY_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "campaign",
              "value": "all"
            },
            {
              "name": "limit",
              "value": "={{ $('Budget').item.json.max * 3 }}"
            },
            {
              "name": "exclude_keys",
              "value": "={{ $('Read CRM').item.json.keys || '' }}"
            }
          ]
        }
      },
      "notesInFlow": true,
      "notes": "OpenStreetMap Overpass (free, no key). Returns ONLY businesses with no real website.",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "8050db5f-cbd4-537b-a311-b734ae954506",
      "name": "Prepare leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        40
      ],
      "parameters": {
        "jsCode": "// hard filters before we spend any AI quota: reachable, named, not already in the CRM, max/day\nconst raw = $input.first().json || {};\nconst src = Array.isArray(raw.leads) ? raw.leads : [];\nconst max = parseInt($env.MAX_LEADS_PER_DAY || '20', 10);\nconst known = (($('Read CRM').item.json || {}).rows) || [];\nconst rowId = {};\nfor (const r of known) if (r.lead_key) rowId[r.lead_key] = r.row_id || '';\nconst SKIP = /chain|bank|mosque|temple|church|fuel|atm|pharmacy chain|municipal|government|post office/i;\nconst seen = new Set();\nconst out = [];\nfor (const l of src) {\n  const name = String(l.osm_name || l.name || '').trim();\n  if (!name || !l.key || seen.has(l.key)) continue;\n  if (seen.has(name.toLowerCase())) continue;\n  if (!(l.whatsapp || l.phone)) continue;\n  if (SKIP.test(name) || SKIP.test(l.category_label || '')) continue;\n  if (!l.address && !l.city) continue;\n  seen.add(l.key); seen.add(name.toLowerCase());\n  out.push({ json: {\n    op: 'upsert', lead_key: l.key, business_name: name.slice(0, 120),\n    category: l.category || 'services', category_label: l.category_label || 'Local business',\n    city: l.city || '', area: l.area || '', country: (l.country || '').toUpperCase(),\n    address: l.address || '', phone: l.phone || '', whatsapp: l.whatsapp || '',\n    website: l.website || '', rating: l.rating || '', reviews: l.reviews_count || '',\n    hours: l.opening_hours || '', notes: (l.notes || '').slice(0, 900), emoji: l.emoji || '\\ud83c\\udfea',\n    hotness: Number(l.hotness || 0), slug: l.slug || '', language: l.language || 'auto',\n    price_label: l.price_label || '', demo_url: '', status: 'scanned', source: 'overpass',\n    reply_count: 0, outbound_count: 0, ai_reply_count: 0, followup_count: 0, paid: 'no',\n    _stats: JSON.stringify(raw.stats || {}), row_id: rowId[l.key] || '',\n  } });\n  if (out.length >= max) break;\n}\nif (!out.length) {\n  return [{ json: { empty: true, _stats: JSON.stringify(raw.stats || {}),\n                    _err: ((raw.stats || {}).errors || []).slice(0, 2).join(' | ') || 'no fresh OSM leads' } }];\n}\nreturn out;",
        "mode": "runOnceForAllItems"
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
