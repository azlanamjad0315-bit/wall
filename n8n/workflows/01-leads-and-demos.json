        1940,
        240
      ],
      "parameters": {
        "jsCode": "const prep = $('Prepare leads').allItems ? $('Prepare leads').allItems().map(i => i.json) : [];\nconst leads = prep.filter(i => !i.empty);\nlet ready = 0, failed = 0;\ntry { ready = $('Result: demo_ready').allItems().length; } catch (e) {}\ntry { failed = $('Result: failed').allItems().filter(i => i.json.lead_key).length; } catch (e) {}\nconst stats = JSON.parse((leads[0] || prep[0] || {})._stats || '{}');\nreturn [{ json: {\n  scanned: stats.osm_raw || 0, fresh: leads.length, ready, failed,\n  errors: (stats.errors || []).slice(0, 3).join(' | '),\n  lines: leads.slice(0, 10).map(l => '\\u2022 ' + l.business_name + ' (' + (l.city || l.area) + ') hotness ' + l.hotness).join('\\n'),\n} }];",
        "mode": "runOnceForAllItems"
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
