    {
      "id": "7d4a0cbf-da42-56e7-8678-57ef515f492e",
      "name": "Result: demo_ready",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2980,
        40
      ],
      "parameters": {
        "jsCode": "const lead = $('Per lead').item.json;\nconst site = $('AI: generate demo site').first().json;\nconst d = $input.first().json || {};\nreturn [{ json: {\n  op: 'upsert', row_id: lead.row_id || '', lead_key: lead.lead_key, business_name: lead.business_name,\n  category: lead.category, category_label: lead.category_label, city: lead.city, area: lead.area,\n  country: lead.country, address: lead.address, phone: lead.phone, whatsapp: lead.whatsapp,\n  website: lead.website, rating: lead.rating, reviews: lead.reviews, hours: lead.hours,\n  hotness: lead.hotness, emoji: lead.emoji, notes: lead.notes, language: lead.language,\n  demo_slug: d.slug || lead.slug, demo_url: d.url || '', design: site.design || {},\n  site_bytes: site.bytes || 0, ai_provider: site.provider || '', status: d.live ? 'demo_ready' : 'deploy_pending',\n  deploy_target: d.target || '', deploy_note: d.note || '', source: 'overpass',\n  next_action_at: new Date().toISOString().slice(0, 10),\n} }];",
        "mode": "runOnceForAllItems"
      },
      "notesInFlow": true,
      "notes": "row_id kept from the CRM read so this updates instead of duplicating",
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "a17ef9c0-da70-569f-9eba-6db02a6b3581",
      "name": "CRM: save demo · body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3240,
        40
      ],
      "parameters": {
        "jsCode": "// drop control keys, stringify objects, keep numbers as numbers -> Baserow user_field_names API\nconst j = $input.first().json || {};\nconst skip = new Set(['row_id', 'op', 'target', 'empty', 'skip', 'why']);\nconst b = {};\nfor (const [k, v] of Object.entries(j)) {\n  if (skip.has(k) || v === undefined || v === null) continue;\n  b[k] = (typeof v === 'object') ? JSON.stringify(v).slice(0, 1500) : v;\n}\nreturn [{ json: { row_id: j.row_id ? String(j.row_id) : '', body_json: JSON.stringify(b),\n                  field_count: Object.keys(b).length } }];",
        "mode": "runOnceForAllItems"
      },
      "notesInFlow": true,
      "notes": "upsert: PATCH if row_id, else POST",
