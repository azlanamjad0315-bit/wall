    {
      "id": "fe832272-2868-5b30-bdd6-c01a453a72c1",
      "name": "Log send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3240,
        240
      ],
      "parameters": {
        "jsCode": "const lead = $('Per lead').item.json;\nconst gate = $('Message safety gate').item.json;\nconst j = $input.first().json || {};\nconst err = j.error || j.message || (j.statusCode ? 'HTTP ' + j.statusCode : '');\nconst ok = !err && (j.id || j.messageId || gate.channel === 'email');\nreturn [{ json: {\n  op: 'upsert', row_id: lead.row_id || '', lead_key: lead.lead_key, business_name: lead.business_name,\n  status: ok ? 'contacted' : 'send_failed', sent_at: new Date().toISOString().slice(0, 10),\n  outbound_count: (Number(lead.outbound_count) || 0) + (ok ? 1 : 0),\n  last_outbound: gate.body, outreach_channel: gate.channel, demo_url: lead.demo_url,\n  category: lead.category, category_label: lead.category_label, city: lead.city,\n  country: lead.country, whatsapp: lead.whatsapp, phone: lead.phone, hotness: lead.hotness,\n  language: lead.language, reply_count: Number(lead.reply_count) || 0,\n  ai_notes: (gate.channel + (gate.fixed ? ' fallback(' + gate.problems + ')' : '') +\n             (ok ? ' ok' : ' ERR ' + String(err).slice(0, 120))).slice(0, 380),\n  next_action_at: ok ? new Date(Date.now() + 2 * 864e5).toISOString().slice(0, 10)\n                     : new Date().toISOString().slice(0, 10) } }];",
        "mode": "runOnceForAllItems"
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "147a8043-7974-54b1-9635-80da9731e633",
      "name": "CRM: mark contacted · body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3500,
        240
      ],
      "parameters": {
        "jsCode": "// drop control keys, stringify objects, keep numbers as numbers -> Baserow user_field_names API\nconst j = $input.first().json || {};\nconst skip = new Set(['row_id', 'op', 'target', 'empty', 'skip', 'why']);\nconst b = {};\nfor (const [k, v] of Object.entries(j)) {\n  if (skip.has(k) || v === undefined || v === null) continue;\n  b[k] = (typeof v === 'object') ? JSON.stringify(v).slice(0, 1500) : v;\n}\nreturn [{ json: { row_id: j.row_id ? String(j.row_id) : '', body_json: JSON.stringify(b),\n                  field_count: Object.keys(b).length } }];",
        "mode": "runOnceForAllItems"
      },
      "notesInFlow": true,
      "notes": "upsert: PATCH if row_id, else POST",
      "alwaysOutputData": true,
      "executeOnce": true
    },
