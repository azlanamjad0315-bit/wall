      ],
      "parameters": {
        "jsCode": "const rows = $('Build queue').allItems ? $('Build queue').allItems().map(i => i.json) : [];\nconst queued = rows.filter(r => !r.empty).length;\nlet sent = 0;\ntry { sent = $('Log send').allItems().filter(i => i.json.status === 'contacted').length; } catch (e) {}\nlet failed = 0;\ntry { failed = $('Log send').allItems().filter(i => i.json.status === 'send_failed').length; } catch (e) {}\nreturn [{ json: { queued, sent, failed, reason: (rows.find(r => r.empty) || {}).reason || '' } }];",
        "mode": "runOnceForAllItems"
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
