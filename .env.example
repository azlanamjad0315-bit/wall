###############################################################################
# DemoSites AI — CONFIG
# 1) copy karein:  cp .env.example .env
# 2) sirf RED wale khane bharna zaroori hai, baaki default pe chal jaate hain
# 3) .env kabhi git me commit NAHI karna
###############################################################################

TZ=Asia/Karachi

# ============================ 1. SECRET / KEYS ==============================
# n8n apne credentials is key se encrypt karta hai. Koi bhi lambi random string:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ai-gateway ke liye internal token (n8n -> gateway). Random bana lein:
#   openssl rand -hex 16
GATEWAY_TOKEN=CHANGE_ME_random_32_chars

# WAHA API key (X-Api-Key header). Random:
#   openssl rand -hex 16
WAHA_API_KEY=CHANGE_ME_random_32_chars
WAHA_PORT=3000
WAHA_SESSION=default
WAHA_ENGINE=WEBJS
WAHA_DASHBOARD_USER=admin
WAHA_DASHBOARD_PASS=CHANGE_ME_dashboard_pass

# n8n UI
N8N_PORT=5678
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
# WAHA ka incoming-message hook. DEFAULT in-network hai → koi tunnel/public URL zaroori NAHI
# (WAHA aur n8n same docker network par hain). Sirf tab badlein jab n8n doosre box par ho,
# ya public URL chahiye: https://xxx.trycloudflare.com/webhook/waha
WAHA_HOOK_URL=http://n8n:5678/webhook/waha
# ai-gateway ka host port (container ke andar hamesha 8787)
GATEWAY_PORT=8787
N8N_EXEC_TIMEOUT=900
EXEC_RETENTION_HOURS=168
N8N_CONCURRENCY=5

# ============================ 2. YOUR OFFER =================================
# Yeh aapki dukaan hai — AI har demo site ke footer me aur har message me
# yahi details daalta hai.
AGENCY_NAME=WebDemo.pk
CONTACT_PHONE=923001234567          # aapka WhatsApp, E.164 bina + ke (92300...)
WHATSAPP_NUMBER=923001234567        # same, footer CTA ke liye
CONTACT_EMAIL=you@example.com       # optional (Structured Data / footer ke liye)

# Price — ek default label, aur chahein to country-wise override map
PRICE_LABEL=PKR 15,000 one-time
# format: CC=Label|CC=Label   (AI lead ke country ke hisaab se choose karega)
PRICE_MAP=PK=PKR 15,000 one-time|BD=BDT 2,500 one-time|IN=INR 4,999 one-time|default=USD 149 one-time
DELIVERY_TIME_TEXT=24 hours me live
OFFER_TEXT=Free revision 1 baar, agar pasand na aaye to PKR 0 — payment sirf tab jab site live ho aur aapko pasand aaye

# Payment details — jo business "Interested" kahe usko AI yehi bhejta hai.
# XXXX ko apne asli numbers se replace karein (search: XXXX)
PAY_METHODS=Easypaisa: XXXX | JazzCash: XXXX
PAY_ACCOUNT_NAME=YOUR ACCOUNT NAME
PAY_INSTRUCTIONS=Payment ke baad screenshot WhatsApp pe bhej dein, 24 ghante me site live + ownership free.

# ============================ 3. AI (FREE) ==================================
# Chain order — pehla jo key ke saath available ho, wahi use hoga; 429/5xx pe
# automatic doosre provider pe fallback.
#   gemini = AI Studio free tier (card nahi chahiye) — 500 requests/day best
#   groq   = console.groq.com free tier — fastest
#   ollama = 100% local/offline, zero API
AI_PROVIDER_CHAIN=gemini,groq,ollama

GEMINI_API_KEY=                      # https://aistudio.google.com/apikey  <- 1 min
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DISABLE_THINKING=true         # free tier TPM bachane ke liye recommended

GROQ_API_KEY=                        # https://console.groq.com/keys
GROQ_MODEL=gpt-oss-120b              # NOTE: Groq free models rotate karte rehte
GROQ_MODEL_FAST=gpt-oss-20b          # hain -> console me current free model yahan
                                     # daal dein, code me kuch nahi badalna
OLLAMA_BASE_URL=http://ollama:11434  # host pe ollama chalao to http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b-instruct    # 8GB RAM pe: qwen2.5:7b-instruct

AI_MAX_TOKENS=16384                  # poora HTML aaram se aa jaaye
AI_TEMPERATURE=0.85                  # design uniqueness ke liye thoda high
AI_TIMEOUT_SECONDS=240               # Ollama + CPU pe 600 tak kar dein
AI_DAILY_REQUESTS_PER_PROVIDER=400   # free RPD se thoda kam rakhein (safety)

# ============================ 4. LEADS (FREE) =================================
# Google Maps API ki zaroorat nahi — OpenStreetMap (Overpass + Nominatim)
# 100% free, no key, no card. Rate-limit policy ke liye email dena zaroori hai:
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
CONTACT_EMAIL=you@example.com        # Nominatim usage policy: contact email
MAX_LEADS_PER_DAY=20                 # roz kitni nayi demo sites banayein
LEADS_RADIUS_METERS=6000
LEADS_CACHE_HOURS=24
LEADS_COOLDOWN_DAYS=30
# true = website tag hai to us par HTTP check karo (thoda slow, zyada accurate)
VERIFY_NO_WEBSITE=false
# config/campaigns/*.json me jitne campaigns enabled hain utne hi chalein
CAMPAIGNS=default

# ============================ 5. HOSTING (FREE) ===============================
# github-pages = sirf ek free GitHub account chahiye, sabse automated
# local        = kuch bhi nahi (testing ke liye, gateway /preview/slug/ pe serve)
DEPLOY_TARGET=github-pages
GITHUB_TOKEN=                        # fine-grained PAT, Repo: Contents Read&write
GITHUB_REPO=YOUR_USERNAME/demo-sites # repo bana kar Pages (Deploy from branch main /) on karein
GITHUB_BRANCH=main
PAGES_BASE_URL=https://YOUR_USERNAME.github.io/demo-sites
# Optional: Cloudflare Pages (instant deploy, no build wait). Docs: docs/hosting.md
CF_PAGES_PROJECT=
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Local preview links (DEPLOY_TARGET=local pe links yahin se banenge)
PUBLIC_PREVIEW_URL=
DEMO_BADGE=true                      # demo site pe "DEMO" ribbon + aapka WhatsApp CTA

# ============================ 6. CRM (FREE) ===================================
# baserow = self-hosted (compose profile baserow) - no account, no OAuth
# gsheets = Google Sheet (n8n Google Sheets credential, 1 min setup)
CRM_BACKEND=baserow
BASEROW_URL=http://baserow:8000
BASEROW_TOKEN=                       # baserow UI -> profile -> Admin tokens
BASEROW_TABLE_ID=                    # tools/baserow_setup.py khud bhar dega
BASEROW_PORT=8100
BASEROW_PUBLIC_URL=http://localhost:8100
# Agar CRM_BACKEND=gsheets: (n8n me credential banayenge, README step 6)
GSHEET_ID=
GSHEET_TAB=leads

# ============================ 7. OUTREACH LIMITS ==============================
MAX_OUTREACH_PER_DAY=25              # 20-30 safe range; number ban se bachne ke liye
OUTREACH_MIN_DELAY_SECONDS=90        # har message ke beech random 90-280s
OUTREACH_MAX_DELAY_SECONDS=280
OUTREACH_CRON=0 11,17 * * 1-6        # roz 11:00 aur 17:00 (Mon-Sat)
LEADS_CRON=0 6 * * *                 # roz subah 6:00 lead scan + demos
REPORT_CRON=0 21 * * *               # raat 9 baje Telegram report
AUTO_REPLY_ENABLED=true              # replies ka AI jawab (WhatsApp pe)
AUTO_REPLY_MAX_PER_THREAD=2          # is se zyada AI khud na bole -> aap baat karein
SEND_IMAGES=true                     # demo ka screenshot message ke saath (needs chromium? false bhi chalega)

# ============================ 8. ALERTS (FREE) ================================
# @BotFather se bot: /newbot -> token. Chat id: @userinfobot ya
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email channel (Gmail app password). Khali chhoda to email skip.
GMAIL_SMTP_FROM=
# n8n me "Gmail SMTP" credential banayein (README step 7) — password yahan nahi

# ============================ 9. OPTIONAL VOICE / CALLING =====================
TTS_PORT=8090
TTS_BACKEND=auto                     # auto | piper | gtts | edge
PIPER_MODEL=en_US-lessac-medium
VOICE_NOTE_ENABLED=false             # true karein to outreach me voice note bhi
